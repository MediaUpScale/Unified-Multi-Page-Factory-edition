# ──────────────────────────────────────────────────────────
#  Unified Multi-Page Factory — .gitignore
# ──────────────────────────────────────────────────────────

# Secrets / credentials
.env
.env.*
*.pem
*.key

# Google Drive shortcut files (not real blobs; break `git add -A`)
*.gsheet

# Local credential JSON (service accounts / ad-hoc secrets)
credentials/*.json
!credentials/tokens/.gitkeep

# Google OAuth2 — client secrets and per-page YouTube access tokens
client_secret*.json
token_*.json
oauth_token*.json
credentials/tokens/
youtube_token_*.json
!credentials/tokens/.gitkeep

# YouTube daily-quota pending-upload queue — runtime state, machine-local paths
credentials/pending_youtube_uploads.json

# Python artefacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.spec
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
Lib/
Scripts/
Include/
pyvenv.cfg

# IDE / Cursor local state
.cursor_local/
.cursor/
.idea/
.vscode/

# Heavy media outputs (generated at runtime)
outputs/
logs/
clips/
*.mp4
*.mp3
*.wav
*.aac
*.mov

# Excel output files
PostPlanner_B2_*.xlsx
postplan_*.xlsx

# Temp / cache files
*.tmp
*TEMP_MPY_wvf_snd*
.cache/
.pytest_cache/
*.log

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Generated per-run telemetry (showcase is optional / detachable)
portfolio_showcase/data/projects/aiwake/architecture.json
